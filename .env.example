# Porta local; o nginx do apex encaminha /estacionamento/ pra cá.
PORT=3007
BASE_PATH=/estacionamento

# Banco PRÓPRIO do projeto (role própria). Não aponte para o banco `comissao`
# do identity/S.A.D: este sistema é isolado.
DATABASE_URL="postgres://estacionamento:SENHA@127.0.0.1:5432/estacionamento"

# Assina o cookie de sessão (estac_sess). Valor só deste projeto — NÃO
# reaproveite o IDENTITY_JWT_SECRET do accounts. Gerar com:
#   openssl rand -base64 48
SESSION_SECRET="<gerar>"

# Em desenvolvimento local (http, sem TLS) ponha `desenvolvimento`, senão o
# cookie sai com Secure e o navegador o descarta.
# NODE_ENV=desenvolvimento

# Aviso ao staff pelo WhatsApp (via Jarvis). Sem AVISO_WHATSAPP_JID fica desligado.
# Aceita JID de grupo (…@g.us) ou só os dígitos de um número (55929…).
# AVISO_WHATSAPP_JID="120363419326670797@g.us"
# JARVIS_FILA_DIR="/opt/jarvis-revemar-cloud/outboxCarros"
# BASE_URL="https://<dominio>/estacionamento"
